# 参考用的上游仓库克隆，不属于本项目
remote-mic-app/

.DS_Store
.build/
*.xcuserstate
dist/
vendor/

# 本机绝对路径的 SPM 镜像配置，重建方法见 docs/dev-dependencies.md
.swiftpm/configuration/mirrors.json

# 端到端体检的本机开关，见 Tests/vInputTests/CorrectionE2ETests.swift
Testing/.e2e-enabled

# 翻译端到端体检的本机开关，见 Tests/vInputTests/TranslationE2ETests.swift
Testing/.translate-e2e-enabled

# xcodebuild 的 DerivedData
.xcbuild/

# 校正模型权重（2.1 GB），不进版本库
Models/

# 基准集录音：二进制且是用户的声音，不进版本库。
# 位于 OneDrive 同步目录内，有云端备份。重录方法见 M5 计划。
Bench/audio/

# 对照运行的临时配置与报告输出
Bench/.run-config.json
Bench/report.txt
Bench/reports/

# prompt 扫描的中间产物。`.prompt-sweep.json` 是门控标记（同 `.run-config.json`），
# 跑完由 trap 删掉，但扫一轮要十几分钟——这期间它是未跟踪文件，
# 一个 `git add -A` 就带进版本库了。
Bench/prompt-sweep*.txt
Bench/.prompt-sweep.json

# 长音频截断对照的门控标记与报告（同上，跑一轮好几分钟，期间是未跟踪文件）
Bench/.long-audio.json
Bench/long-audio.txt

# 解码参数三维对照（scripts/decode-sweep.sh）。跑一轮近一小时，期间标记文件
# 是未跟踪状态。**结论不靠这个文件传递**——它每轮被覆盖，带时间戳的副本在
# 已忽略的 Bench/reports/ 里；进版本库的是 docs/Roadmap.md 里的对照表。
Bench/.decode-sweep.json
Bench/decode-sweep.txt
Bench/decode-sweep-scaling.txt

# 蓝牙鼠标抓包的离线解码产物（scripts/mouse-decode.sh）：抓包快照、裸 SBC
# 码流、解出的 WAV、报告。都是用户的声音，且抓包一份就有几 MB。
# 门控标记 .run-config.json 同 Bench/.run-config.json，跑完由 trap 删掉，
# 但这中间它是未跟踪文件，一个 `git add -A` 就带进版本库了。
MouseDecode/

# 翻译对照（scripts/translate-sweep.sh）。`.translate-sweep.json` 是门控标记
# （同 `.run-config.json`），跑完由 trap 删掉，但全量一轮 26×6=156 次推理要
# 几十分钟——这期间它是未跟踪文件，一个 `git add -A` 就带进版本库了，
# 而它里面是本机绝对路径。报告是产物，每轮被覆盖。
Bench/.translate-sweep.json
Bench/translate-sweep.txt

# Whisper 直译对照（scripts/whisper-translate.sh）。理由与上面那一对完全相同：
# 标记文件里是本机绝对路径，报告是每轮被覆盖的产物。
Bench/.whisper-translate.json
Bench/whisper-translate.txt

# 云端翻译端到端体检的本机开关，见 Tests/vInputTests/GeminiE2ETests.swift
Testing/.gemini-e2e-enabled
